{
  "name": "gff-uzbekistan",
  "version": "1.0.0",
  "private": true,
  "description": "Gulf Flavours & Fragrances — O'zbekistondagi rasmiy va yagona distribyutor. B2B lead-generation sayti.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "npm run prepare:assets && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare:assets": "node scripts/copy-fonts.mjs && node scripts/build-catalog.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "postinstall": "node scripts/copy-fonts.mjs",
    "start:next": "next start"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "next": "16.3.4",
    "nodemailer": "^7.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
