# ============================================================
#  GFF UZBEKISTAN — muhit o'zgaruvchilari
#
#  Nusxa oling:   cp .env.example .env.local
#  Tekshiring:    npm run env:check        (launch uchun nima yetishmaydi)
#
#  HECH QACHON .env.local faylini git'ga commit qilmang!
#
#  Qoida: bu faylda §15 (brief) dagi RASMIY kontaktlar yozilgan.
#  To'qilgan qiymat (masalan +998712000000 yoki info@gff.uz) QO'YILMAYDI —
#  `npm run env:check` bunday qiymatni topsa XATO beradi.
#  Bo'sh qoldirilgan kalit uchun `src/lib/config.ts` dagi standart ishlaydi.
# ============================================================


# ---------- 1. SAYT / DOMEN ----------------------------------
# LAUNCH UCHUN MAJBURIY: canonical, hreflang, sitemap va JSON-LD shu
# domenga quriladi. Bo'sh qoldirilsa — Vercel URL yoki localhost:3000
# ishlatiladi va SEO noto'g'ri bo'ladi. Slash bilan tugamasin.
NEXT_PUBLIC_SITE_URL=""

# Metadata'dagi sayt nomi (standart: "GFF Uzbekistan")
NEXT_PUBLIC_SITE_NAME="GFF Uzbekistan"


# ---------- 2. ALOQA (§15 — mijoz bergan rasmiy ma'lumotlar) ---
# Telefon. `tel:` havolasi avtomatik raqamga aylantiriladi.
NEXT_PUBLIC_PHONE_PRIMARY="+998 97 570 77 60"
NEXT_PUBLIC_PHONE_SECONDARY=""

# E-mail. ✔ Mijoz tasdiqladi (2026-10-12): info@gulfflavour.uz
#   (avvalgi "info@gulfflovour.uz" yozuvi xato edi)
NEXT_PUBLIC_EMAIL="info@gulfflavour.uz"
NEXT_PUBLIC_SALES_EMAIL="info@gulfflavour.uz"

# Manzil — uch tilda (footer, aloqa sahifasi, LocalBusiness JSON-LD)
NEXT_PUBLIC_ADDRESS="Toshkent, Mirzo Ulug‘bek tumani, Mustaqillik shoh ko‘chasi, 128"
NEXT_PUBLIC_ADDRESS_RU="Ташкент, Мирзо-Улугбекский район, проспект Мустакиллик, 128"
NEXT_PUBLIC_ADDRESS_EN="128 Mustaqillik Ave., Mirzo Ulugbek district, Tashkent"

# Ish vaqti (§15): Du–Ju 09:00–18:00, Sha 10:00–15:00
NEXT_PUBLIC_HOURS_WEEK_FROM="09:00"
NEXT_PUBLIC_HOURS_WEEK_TO="18:00"
NEXT_PUBLIC_HOURS_SAT_FROM="10:00"
NEXT_PUBLIC_HOURS_SAT_TO="15:00"
NEXT_PUBLIC_WORK_HOURS="Du–Ju 09:00–18:00, Sha 10:00–15:00"

# Bosh ofis (GFF FZCO, Jebel Ali, Dubay) manzili va telefoni kodda
# qattiq yozilgan (§15). HQ e-maili brief'da BERILMAGAN — mijoz bersa
# to'ldiring; bo'sh bo'lsa maydon UMUMAN ko'rsatilmaydi (o'lik havola yo'q).
NEXT_PUBLIC_HQ_EMAIL=""


# ---------- 3. IJTIMOIY TARMOQLAR (§15) -----------------------
NEXT_PUBLIC_TELEGRAM="https://t.me/GFF_uzb"
NEXT_PUBLIC_TELEGRAM_HANDLE="@GFF_uzb"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/gulfflavour.uz"
NEXT_PUBLIC_INSTAGRAM_HANDLE="@gulfflavour.uz"

# Ota-brend sayti (§1) — JSON-LD `sameAs` uchun
NEXT_PUBLIC_PARENT_SITE="https://gulfflavours.ae"

# Quyidagilari brief'da YO'Q — bo'sh bo'lsa havola ko'rsatilmaydi
NEXT_PUBLIC_LINKEDIN=""
NEXT_PUBLIC_FACEBOOK=""
NEXT_PUBLIC_TWITTER_HANDLE=""


# ---------- 4. LEAD BILDIRISHNOMALARI (§11.1) -----------------
# Kamida BITTA kanal yoqilishi kerak, aks holda arizalar faqat
# `data/leads/*.jsonl` fayliga yoziladi (server yo'qolsa — yo'qoladi).
# Holatni ko'rish: npm run env:check
#
# 4a. Telegram bot — TAVSIYA ETILADI (eng tez)
#   1) @BotFather → /newbot → TELEGRAM_BOT_TOKEN
#   2) Botni guruhga qo'shing va chat_id oling (vergul bilan bir nechta:
#      "111111,-100222222"); forum bo'lsa TELEGRAM_TOPIC_ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_TOPIC_ID=""

# 4b. E-mail (SMTP). Bo'sh bo'lsa — e-mail yuborilmaydi.
#    ⚠ SPF/DKIM sozlangan REAL domendan yuboring, aks holda spam'ga tushadi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
LEAD_EMAIL_TO=""

# 4b-alt. Resend (serverless uchun qulayroq) — SMTP o'rniga ishlatsa bo'ladi
RESEND_API_KEY=""

# 4c. Universal webhook (amoCRM / Bitrix24 / n8n / Make)
#     Har lead uchun POST JSON. CRM'ga ulanish shu orqali (§11.1).
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET=""


# ---------- 5. ANTISPAM (§11.2) -------------------------------
# Honeypot + tezlik cheklovi + min fill 3s HAR DOIM yoqilgan (kod ichida).
# Qo'shimcha: Cloudflare Turnstile (reCAPTCHA o'rniga, bepul). Ikkalasi ham
# bo'sh bo'lsa — faqat ichki himoya ishlaydi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# §11.2 talabi: bir IP dan 5 ta so'rov / 10 minut. O'zgartirmang.
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="600"

# Bir xil telefon bilan ikki ariza orasidagi minimal vaqt (sekund)
DUPLICATE_GUARD_SECONDS="120"


# ---------- 6. ADMIN PANEL (/uz/admin) ------------------------
# Ikkalasini ham ALMASHTIRING — standart qiymat bilan panel yopilmaydi,
# lekin `env:check` launch'dan oldin xato beradi.
ADMIN_PASSWORD=""
# 32+ belgili tasodifiy satr:   openssl rand -hex 32
ADMIN_SECRET=""
ADMIN_COOKIE_NAME="gff_admin"
ADMIN_SESSION_HOURS="12"


# ---------- 7. LEAD SAQLASH -----------------------------------
# "file" (standart, JSONL) — VPS/docker uchun ideal.
LEAD_STORAGE_DRIVER="file"
# MUTLAQ (absolute) yo'l tavsiya etiladi: standalone server
# `process.chdir(__dirname)` qiladi, shuning uchun nisbiy yo'l
# `.next/standalone` ga nisbatan hisoblanadi va `next build` paytida
# lead'lar o'chib ketishi mumkin.
#   Bo'sh bo'lsa: <cwd>/data/leads   ·   Docker'da: /app/data/leads (volume)
# `scripts/start.mjs` lokal ishga tushirishda uni loyiha ildiziga o'rnatadi.
LEAD_STORAGE_PATH=""


# ---------- 8. ANALITIKA (§12) --------------------------------
# GTM konteyneri — GA4 va Meta Pixel shu orqali ulanadi. Bo'sh bo'lsa
# `dataLayer` hodisalari yoziladi, lekin hech qaerga yuborilmaydi.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_YANDEX_METRIKA_ID=""


# ---------- 9. BIZNES QOIDALARI (§7.2, §15) -------------------
# Namuna qutisi: 8 tagacha, 25–100 g, 3 ish kuni (brief §1)
SAMPLE_BOX_MAX_ITEMS="8"
NEXT_PUBLIC_SAMPLE_BOX_MAX="8"
SAMPLE_MIN_VOLUME="25"
SAMPLE_MAX_VOLUME="100"
SAMPLE_DELIVERY_DAYS="3"

# ⚠ JOY TUTGICH — mijoz tasdiqlashi kerak (CLAUDE.md §9.1):
#   minimal ulgurji buyurtma (kg)
MIN_ORDER_KG="5"
# chegara (kg) va hajmli chegirma (%) — "100 kg dan 10%" aksiya matni uchun
DISCOUNT_THRESHOLD_KG="100"
VOLUME_DISCOUNT_PCT="10"
# javob berish va'dasi (minut) — rahbarlik xabari shu sondan quriladi
RESPONSE_MINUTES="30"


# ---------- 10. KONTENT FAYLLARI (§15 TODO) -------------------
# Fayl `public/` da bo'lishi kerak. BO'SH bo'lsa yoki fayl topilmasa —
# tugma/blok UMUMAN ko'rsatilmaydi (`publicAssetExists` tekshiradi),
# ya'ni o'lik havola paydo bo'lmaydi.
#
# Katalog PDF (TDS/SDS/Halal/ISO hujjatlari ham shu joydan)
NEXT_PUBLIC_CATALOG_PDF=""
# Ishlab chiqarish videosi (About/Hero uchun)
NEXT_PUBLIC_PRODUCTION_VIDEO=""


# ============================================================
#  INFRASTRUKTURA O'ZGARUVCHILARI — .env ga YAZILMAYDI
#  (bular deploy muhitida yoki buyruq satrida beriladi)
#
#    PORT / HOSTNAME  — standalone server (standart 3000 / 0.0.0.0)
#    BASE_URL         — test/audit skriptlari qaysi serverga urilishini
#                       belgilaydi (standart http://127.0.0.1:3000)
#    REQUIRE_SERVER=1 — `npm test` da 3-qatlam (render HTML) majburiy
#    NODE_ENV         — Next o'zi o'rnatadi
#    ALLOW_FRAMING=1  — production'da ham ommaviy sahifalarni iframe'ga ruxsat
#                       (faqat preview muhit uchun; standart: SAMEORIGIN)
#                       BUILD vaqtida o'qiladi — runtime'da berish ta'sir qilmaydi
#    VERCEL_PROJECT_PRODUCTION_URL — Vercel o'zi beradi
# ============================================================
