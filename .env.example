# ============================================================
#  GFF UZBEKISTAN — muhit o'zgaruvchilari (Environment)
#  Nusxa oling:  cp .env.example .env.local
#  HECH QACHON .env.local faylini git'ga commit qilmang!
# ============================================================

# ---------- 1. SAYT / DOMEN --------------------------------
# Kanonik URL, sitemap va SEO meta uchun. Slash bilan tugamasin.
NEXT_PUBLIC_SITE_URL="https://gff.uz"

# Sayt nomi (metadata uchun)
NEXT_PUBLIC_SITE_NAME="GFF Uzbekistan — Gulf Flavours & Fragrances"

# Ijtimoiy tarmoqlar (bo'sh qoldirilsa — havola ko'rsatilmaydi)
NEXT_PUBLIC_TELEGRAM_CHANNEL="https://t.me/gffuzbekistan"
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_LINKEDIN=""
NEXT_PUBLIC_FACEBOOK=""

# ---------- 2. ALOQA MA'LUMOTLARI ----------------------------
NEXT_PUBLIC_PHONE_PRIMARY="+998712000000"
NEXT_PUBLIC_PHONE_SECONDARY="+998901234567"
NEXT_PUBLIC_EMAIL="info@gff.uz"
NEXT_PUBLIC_SALES_EMAIL="sales@gff.uz"
NEXT_PUBLIC_ADDRESS="Toshkent sh., Mirzo Ulug'bek tumani, Mustaqillik shoh ko'chasi 128"
NEXT_PUBLIC_WORK_HOURS="Du–Ju 09:00–18:00, Shа 10:00–15:00"

# ---------- 3. LEAD BILDIRISHNOMALARI ------------------------
# 3a. Telegram bot (TAVSIYA ETILADI — leadlar shu zahoti yetib boradi)
#    1) @BotFather orqali bot yarating -> TELEGRAM_BOT_TOKEN
#    2) Botni guruhga qo'shing yoki shaxsiy chat_id oling
#    3) Bir nechta qabul qiluvchi: vergul bilan ajrating "111111,-100222222"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_TOPIC_ID=""

# 3b. E-mail (SMTP). Bo'sh bo'lsa — e-mail yuborilmaydi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GFF Uzbekistan <no-reply@gff.uz>"
LEAD_EMAIL_TO="sales@gff.uz"

# 3c. Universal webhook (amoCRM / Bitrix24 / n8n / Make)
#    Har bir lead uchun POST JSON yuboriladi.
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET=""

# ---------- 4. ANTISPAM --------------------------------------
# Honeypot + tezlik cheklovi har doim yoqilgan.
# Qo'shimcha: Cloudflare Turnstile (Google reCAPTCHA o'rniga, bepul)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Bir IP dan ruxsat etilgan so'rovlar / oynada (sekund)
RATE_LIMIT_MAX="8"
RATE_LIMIT_WINDOW_SECONDS="600"

# Ikki bir xil lead orasidagi minimal vaqt (bir xil telefon bilan), sekund
DUPLICATE_GUARD_SECONDS="120"

# ---------- 5. ADMIN PANEL -----------------------------------
# /uz/admin — leadlar bazasi. Ikkalasini ham ALMASHTIRING!
ADMIN_PASSWORD="o'zgartiring-kuchli-parol"
# 32+ belgidan iborat tasodifiy satr: openssl rand -hex 32
ADMIN_SECRET="openssl-rand-hex-32-natijasini-shu-yerga-qo'ying"
ADMIN_COOKIE_NAME="gff_admin"
ADMIN_SESSION_HOURS="12"

# ---------- 6. LEAD SAQLASH ----------------------------------
# "file" (default, JSONL) — VPS/docker uchun ideal.
LEAD_STORAGE_DRIVER="file"
# Lead papkasi. MUTLAQ (absolute) yo'l tavsiya etiladi: standalone server
# `process.chdir(__dirname)` qiladi, shuning uchun nisbiy yo'l `.next/standalone`
# ga nisbatan hisoblanadi va `next build` paytida lead'lar o'chib ketishi mumkin.
# Bo'sh qoldirilsa: <cwd>/data/leads. Docker'da: /app/data/leads (volume).
# scripts/start.mjs lokal ishga tushirishda uni avtomatik loyiha ildiziga o'rnatadi.
LEAD_STORAGE_PATH=""

# ---------- 7. ANALITIKA -------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# ---------- 8. BIZNES QOIDALARI ------------------------------
# Namuna (test box) qutisiga eng ko'pi nechta mahsulot joylanadi
SAMPLE_BOX_MAX_ITEMS="8"
NEXT_PUBLIC_SAMPLE_BOX_MAX="8"
# Bepul namuna chegarasi (ml/gr)
SAMPLE_MAX_VOLUME="100"
# Yetkazib berish va'dasi (kun)
SAMPLE_DELIVERY_DAYS="3"
# Minimal ulgurji buyurtma (kg)
MIN_ORDER_KG="5"
